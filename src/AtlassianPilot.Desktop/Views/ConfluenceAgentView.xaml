<UserControl x:Class="AtlassianPilot.Desktop.Views.ConfluenceAgentView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<StackPanel>
		<TextBlock Text="Ask about your Confluence pages" Style="{StaticResource Title}"/>
		<TextBlock Text="Search, summarise, improve or create pages in plain English. Nothing is saved until you approve it." Style="{StaticResource Muted}" Margin="0,4,0,18"/>
		<ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate>
			<Border Style="{StaticResource Bubble}"><StackPanel>
				<TextBlock Text="{Binding Speaker}" Style="{StaticResource Label}" Foreground="{DynamicResource CyanBrush}" Margin="0"/>
				<TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0"/>
			</StackPanel></Border>
		</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
		<Border Style="{StaticResource Card}"><StackPanel>
			<TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="220" VerticalScrollBarVisibility="Auto" MaxLength="4000" IsEnabled="{Binding CanEdit}" Margin="0,0,0,10" AutomationProperties.Name="Confluence request"/>
			<WrapPanel>
				<Button Content="Ask" Style="{StaticResource Primary}" Command="{Binding SendCommand}" IsEnabled="{Binding CanEdit}" MinWidth="90"/>
				<Button Content="New conversation" Style="{StaticResource Quiet}" Command="{Binding NewConversationCommand}" IsEnabled="{Binding CanEdit}"/>
				<Button Content="New page" Style="{StaticResource Quiet}" Command="{Binding NewDraftCommand}" IsEnabled="{Binding CanEdit}"/>
				<Button Content="Cancel" Style="{StaticResource Quiet}" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}"/>
			</WrapPanel>
			<ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8" Visibility="{Binding Busy, Converter={StaticResource VisibleWhenTrue}}"/>
			<TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite"/>
			<TextBlock Text="Try: &quot;Find pages about on-call alerts&quot;, &quot;Summarise page 123456&quot; or &quot;Remove 'Roadmap' from the title of page 123456&quot;." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
		</StackPanel></Border>
		<Border Style="{StaticResource Card}" Visibility="{Binding HasPages, Converter={StaticResource VisibleWhenTrue}}"><StackPanel>
			<TextBlock Text="Pages found" Style="{StaticResource Section}"/>
			<ItemsControl ItemsSource="{Binding Pages}"><ItemsControl.ItemTemplate><DataTemplate>
				<Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8"><DockPanel>
					<Button DockPanel.Dock="Right" Content="Edit" Margin="12,0,0,0" VerticalAlignment="Center" Command="{Binding DataContext.LoadPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" AutomationProperties.Name="Load page for editing"/>
					<StackPanel>
						<Button Content="{Binding Title}" Tag="{Binding Url}" Click="OpenPage" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Padding="0" Margin="0" Foreground="{DynamicResource CyanBrush}" FontWeight="SemiBold"/>
						<TextBlock Text="{Binding SpaceKey, StringFormat='Space {0}'}" Style="{StaticResource Hint}"/>
						<TextBlock Text="{Binding Excerpt}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
					</StackPanel>
				</DockPanel></Border>
			</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
			<Button Content="Load more results" Command="{Binding LoadMoreCommand}" IsEnabled="{Binding CanLoadMore}" HorizontalAlignment="Left"/>
		</StackPanel></Border>
		<Border Style="{StaticResource Card}"><Expander Header="Page editor" IsExpanded="{Binding IsEditorOpen, Mode=TwoWay}" Margin="0"><StackPanel IsEnabled="{Binding CanEdit}">
			<TextBlock Text="Leave Page ID empty to create a new page. Load a page (Edit) or enter its numeric ID to update it." Style="{StaticResource Hint}" Margin="0,0,0,8"/>
			<Grid>
				<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
				<StackPanel><TextBlock Text="Space key" Style="{StaticResource Label}"/><TextBox Text="{Binding SpaceKey, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" AutomationProperties.Name="Confluence space key"/></StackPanel>
				<StackPanel Grid.Column="2"><TextBlock Text="Page ID (empty = new page)" Style="{StaticResource Label}"/><TextBox Text="{Binding PageId, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" AutomationProperties.Name="Confluence page ID"/></StackPanel>
			</Grid>
			<TextBlock Text="Title" Style="{StaticResource Label}"/><TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" AutomationProperties.Name="Confluence page title"/>
			<TextBlock Text="Body" Style="{StaticResource Label}"/><TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="200" MaxHeight="480" VerticalScrollBarVisibility="Auto" MaxLength="32000" AutomationProperties.Name="Confluence page content"/>
			<Button Content="Review before saving" Command="{Binding PrepareSaveCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
		</StackPanel></Expander></Border>
		<Border Style="{StaticResource Card}" Visibility="{Binding HasPreview, Converter={StaticResource VisibleWhenTrue}}"><StackPanel>
			<TextBlock Text="Approve this change" Style="{StaticResource Section}"/>
			<TextBlock Text="{Binding Preview.Action, StringFormat='Action: {0}'}"/>
			<TextBlock Text="{Binding Preview.Title, StringFormat='Title: {0}'}" TextWrapping="Wrap"/>
			<TextBlock Text="{Binding Preview.SpaceKey, StringFormat='Space: {0}'}"/>
			<TextBlock Text="Updating replaces the body with plain-text paragraphs. This preview expires after 15 minutes and any edit cancels it. Nothing is saved until you approve." Style="{StaticResource Hint}" Margin="0,8,0,8"/>
			<Expander Header="Exact request" Margin="0,0,0,8"><TextBox Text="{Binding PreviewJson, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="320" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Exact Confluence save payload"/></Expander>
			<Button Content="Approve and save page" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
		</StackPanel></Border>
		<Border Style="{StaticResource Card}" Visibility="{Binding HasSavedPage, Converter={StaticResource VisibleWhenTrue}}"><StackPanel>
			<TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
			<Button Content="Open saved page" Tag="{Binding SavedPage.Url}" Click="OpenPage" HorizontalAlignment="Left" Margin="0,10,0,0"/>
		</StackPanel></Border>
	</StackPanel>
</UserControl>
