<UserControl x:Class="AtlassianPilot.Desktop.Views.AgentHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Agent history" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Jira and Confluence chat transcripts are kept in the local workspace database for 30 days. The database is not encrypted. Avoid saving secrets or highly sensitive content. You can delete one transcript or clear all history at any time." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,14"/>
            <WrapPanel>
                <TextBlock Text="Agent" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding AgentFilters}" SelectedItem="{Binding SelectedAgent}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="History agent filter" Width="160"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanEdit}"/>
                <Button Content="Delete selected" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanEdit}"/>
                <Button Content="Delete all history" Command="{Binding DeleteAllCommand}" IsEnabled="{Binding CanEdit}"/>
            </WrapPanel>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,8" Visibility="{Binding Busy, Converter={StaticResource VisibleWhenTrue}}"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Saved conversations" FontSize="20" FontWeight="SemiBold"/>
            <ListBox ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}" MaxHeight="260" AutomationProperties.Name="Saved conversations">
                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Agent, StringFormat='Agent: {0}'}" Style="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding UpdatedAt, StringFormat='Updated: {0:g}'}" Style="{StaticResource Muted}" FontSize="12"/>
                </StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}" Visibility="{Binding HasSelectedConversation, Converter={StaticResource VisibleWhenTrue}}"><StackPanel>
            <TextBlock Text="Selected transcript" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SelectedConversation.Title}" FontWeight="SemiBold" Margin="0,8,0,8"/>
            <ItemsControl ItemsSource="{Binding SelectedConversation.Messages}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8"><StackPanel>
                    <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" Foreground="{DynamicResource CyanBrush}"/>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></Border>
    </StackPanel>
</UserControl>
