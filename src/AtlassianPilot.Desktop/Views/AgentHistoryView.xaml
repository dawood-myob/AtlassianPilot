<UserControl x:Class="AtlassianPilot.Desktop.Views.AgentHistoryView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<StackPanel>
		<TextBlock Text="Past conversations" Style="{StaticResource Title}"/>
		<TextBlock Text="Saved on this PC for 30 days, unencrypted. Avoid putting secrets in chats." Style="{StaticResource Muted}" Margin="0,4,0,18"/>
		<Border Style="{StaticResource Card}"><StackPanel>
			<DockPanel Margin="0,0,0,4">
				<WrapPanel DockPanel.Dock="Right">
					<Button Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanEdit}" Style="{StaticResource Quiet}"/>
					<Button Content="Delete selected" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanEdit}"/>
					<Button Content="Delete all" Command="{Binding DeleteAllCommand}" IsEnabled="{Binding CanEdit}"/>
				</WrapPanel>
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,10,8" Style="{StaticResource Label}"/>
					<ComboBox ItemsSource="{Binding AgentFilters}" SelectedItem="{Binding SelectedAgent}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="History agent filter" Width="160" Margin="0,0,0,8"/>
				</StackPanel>
			</DockPanel>
			<ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8" Visibility="{Binding Busy, Converter={StaticResource VisibleWhenTrue}}"/>
			<TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
			<ListBox ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}" MaxHeight="280" AutomationProperties.Name="Saved conversations">
				<ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,2">
					<TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
					<TextBlock Style="{StaticResource Hint}"><Run Text="{Binding Agent, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding UpdatedAt, StringFormat='{}{0:g}', Mode=OneWay}"/></TextBlock>
				</StackPanel></DataTemplate></ListBox.ItemTemplate>
			</ListBox>
		</StackPanel></Border>
		<Border Style="{StaticResource Card}" Visibility="{Binding HasSelectedConversation, Converter={StaticResource VisibleWhenTrue}}"><StackPanel>
			<TextBlock Text="{Binding SelectedConversation.Title}" Style="{StaticResource Section}"/>
			<ItemsControl ItemsSource="{Binding SelectedConversation.Messages}"><ItemsControl.ItemTemplate><DataTemplate>
				<Border Style="{StaticResource Bubble}"><StackPanel>
					<TextBlock Text="{Binding Speaker}" Style="{StaticResource Label}" Foreground="{DynamicResource CyanBrush}" Margin="0"/>
					<TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0"/>
				</StackPanel></Border>
			</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
		</StackPanel></Border>
	</StackPanel>
</UserControl>
