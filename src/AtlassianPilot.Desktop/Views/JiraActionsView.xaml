<UserControl x:Class="AtlassianPilot.Desktop.Views.JiraActionsView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<StackPanel>
		<TextBlock Text="Change an existing issue" Style="{StaticResource Title}"/>
		<TextBlock Text="Enter an issue key, pick what to change, and review the exact request before anything is sent to Jira." Style="{StaticResource Muted}" Margin="0,4,0,18"/>
		<Border Style="{StaticResource Card}"><StackPanel>
			<TextBlock Text="Issue key" Style="{StaticResource Label}"/>
			<TextBox Text="{Binding IssueKey, UpdateSourceTrigger=PropertyChanged}" MaxWidth="260" HorizontalAlignment="Left" MaxLength="255" AutomationProperties.Name="Jira action issue key"/>
			<ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8" Visibility="{Binding Busy, Converter={StaticResource VisibleWhenTrue}}"/>
			<DockPanel>
				<Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource Quiet}" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}" Margin="8,0,0,0"/>
				<TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite"/>
			</DockPanel>
		</StackPanel></Border>
		<Border Style="{StaticResource Card}" Visibility="{Binding HasPreview, Converter={StaticResource VisibleWhenTrue}}"><StackPanel>
			<TextBlock Text="Approve this change" Style="{StaticResource Section}"/>
			<TextBlock Text="{Binding Preview.Action, StringFormat='Action: {0}'}"/>
			<TextBlock Text="{Binding Preview.IssueKey, StringFormat='Issue: {0}'}"/>
			<TextBlock Text="{Binding Preview.Summary}" TextWrapping="Wrap"/>
			<TextBlock Text="{Binding Preview.ExpiresAt, StringFormat='Expires: {0:g}'}" Style="{StaticResource Hint}" Margin="0,4,0,8"/>
			<Expander Header="Exact request" Margin="0,0,0,8"><TextBox Text="{Binding Preview.PayloadJson, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="320" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Jira action payload"/></Expander>
			<Button Content="Approve and execute" Command="{Binding ApproveCommand}" IsEnabled="{Binding CanApprove}" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
		</StackPanel></Border>
		<Border Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource VisibleWhenTrue}}"><StackPanel>
			<TextBlock Text="{Binding Result.Message}" TextWrapping="Wrap"/>
			<Button Content="Open cloned issue" Tag="{Binding Result.IssueUrl}" Click="OpenIssue" Visibility="{Binding HasIssueUrl, Converter={StaticResource VisibleWhenTrue}}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
		</StackPanel></Border>
		<Border Style="{StaticResource Card}" Padding="20,8"><StackPanel IsEnabled="{Binding CanEdit}">
			<TextBlock Text="What do you want to do?" Style="{StaticResource Label}" Margin="0,8,0,0"/>
			<Expander Header="Edit summary or description">
				<StackPanel>
					<TextBlock Text="Leave a field empty to keep it unchanged." Style="{StaticResource Hint}"/>
					<TextBlock Text="Summary" Style="{StaticResource Label}"/><TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" AutomationProperties.Name="Updated Jira summary"/>
					<TextBlock Text="Description" Style="{StaticResource Label}"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="180" AutomationProperties.Name="Updated Jira description"/>
					<Button Content="Review update" Command="{Binding PrepareUpdateCommand}" HorizontalAlignment="Left"/>
				</StackPanel>
			</Expander>
			<Expander Header="Add a comment">
				<StackPanel>
					<TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="140" AutomationProperties.Name="Jira comment"/>
					<Button Content="Review comment" Command="{Binding PrepareCommentCommand}" HorizontalAlignment="Left"/>
				</StackPanel>
			</Expander>
			<Expander Header="Assign to someone">
				<StackPanel>
					<TextBlock Text="Jira account ID of the assignee (names and emails are not accepted)." Style="{StaticResource Hint}"/>
					<TextBox Text="{Binding AccountId, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" AutomationProperties.Name="Jira assignee account ID"/>
					<Button Content="Review assignment" Command="{Binding PrepareAssignmentCommand}" HorizontalAlignment="Left"/>
				</StackPanel>
			</Expander>
			<Expander Header="Change status">
				<StackPanel>
					<Button Content="Load available statuses" Command="{Binding LoadTransitionsCommand}" HorizontalAlignment="Left"/>
					<ComboBox ItemsSource="{Binding Transitions}" SelectedItem="{Binding SelectedTransition}" AutomationProperties.Name="Available Jira transitions"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#16213B"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
					<Button Content="Review status change" Command="{Binding PrepareTransitionCommand}" HorizontalAlignment="Left"/>
				</StackPanel>
			</Expander>
			<Expander Header="Link to another issue">
				<StackPanel>
					<Button Content="Load link types" Command="{Binding LoadLinkTypesCommand}" HorizontalAlignment="Left"/>
					<ComboBox ItemsSource="{Binding LinkTypes}" SelectedItem="{Binding SelectedLinkType}" AutomationProperties.Name="Available Jira issue link types"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name, StringFormat='{}{0} (review direction below)'}" Foreground="#16213B"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
					<TextBlock Text="{Binding SelectedLinkType.Outward, StringFormat='This issue: {0}'}" Style="{StaticResource Hint}"/>
					<TextBlock Text="{Binding SelectedLinkType.Inward, StringFormat='Linked issue: {0}'}" Style="{StaticResource Hint}"/>
					<TextBlock Text="Issue to link" Style="{StaticResource Label}"/><TextBox Text="{Binding LinkedIssueKey, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" AutomationProperties.Name="Issue to link"/>
					<Button Content="Review link" Command="{Binding PrepareLinkCommand}" HorizontalAlignment="Left"/>
				</StackPanel>
			</Expander>
			<Expander Header="Clone to a project">
				<StackPanel>
					<TextBlock Text="Copies the summary and description only. Comments, attachments, links and other fields are not copied." Style="{StaticResource Hint}"/>
					<TextBlock Text="Destination project key" Style="{StaticResource Label}"/><TextBox Text="{Binding CloneProjectKey, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" AutomationProperties.Name="Clone destination project key"/>
					<TextBlock Text="Issue type" Style="{StaticResource Label}"/><TextBox Text="{Binding CloneIssueType, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" AutomationProperties.Name="Clone destination issue type"/>
					<Button Content="Review clone" Command="{Binding PrepareCloneCommand}" HorizontalAlignment="Left"/>
				</StackPanel>
			</Expander>
		</StackPanel></Border>
	</StackPanel>
</UserControl>
