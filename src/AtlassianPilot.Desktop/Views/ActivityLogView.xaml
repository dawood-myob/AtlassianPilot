<UserControl x:Class="AtlassianPilot.Desktop.Views.ActivityLogView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<StackPanel>
		<TextBlock Text="Activity log" Style="{StaticResource Title}"/>
		<TextBlock Text="A local record of what the agents did. It stores action names and outcomes only (no prompts, page contents or credentials) and is kept for 90 days." Style="{StaticResource Muted}" Margin="0,4,0,18"/>
		<Border Style="{StaticResource Card}"><StackPanel>
			<DockPanel Margin="0,0,0,4">
				<WrapPanel DockPanel.Dock="Right">
					<Button Content="Apply" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanEdit}"/>
					<Button Content="Clear log" Command="{Binding ClearCommand}" IsEnabled="{Binding CanEdit}"/>
				</WrapPanel>
				<StackPanel Orientation="Horizontal">
					<ComboBox ItemsSource="{Binding AgentFilters}" SelectedItem="{Binding SelectedAgent}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Activity agent filter" Width="150" Margin="0,0,10,8"/>
					<TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Activity text filter" Width="220" Margin="0,4,0,8"/>
				</StackPanel>
			</DockPanel>
			<ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8" Visibility="{Binding Busy, Converter={StaticResource VisibleWhenTrue}}"/>
			<TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
			<ItemsControl ItemsSource="{Binding Entries}"><ItemsControl.ItemTemplate><DataTemplate>
				<Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10"><Grid>
					<Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
					<TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:g}'}" Style="{StaticResource Hint}"/>
					<TextBlock Grid.Column="1" Text="{Binding Agent}"/>
					<TextBlock Grid.Column="2" Text="{Binding Action}" FontWeight="SemiBold"/>
					<TextBlock Grid.Column="3" Text="{Binding Outcome}" Foreground="{DynamicResource CyanBrush}"/>
				</Grid></Border>
			</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
		</StackPanel></Border>
	</StackPanel>
</UserControl>
