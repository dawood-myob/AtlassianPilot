<UserControl x:Class="AtlassianPilot.Desktop.Views.ActivityLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Agent activity" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="This local audit records only fixed action and outcome labels (no prompts, page contents, issue summaries, credentials or request payloads). Entries expire after 90 days and are capped at 5,000. The SQLite database is not encrypted." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,14"/>
            <WrapPanel>
                <TextBlock Text="Agent" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding AgentFilters}" SelectedItem="{Binding SelectedAgent}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Activity agent filter" Width="160"/>
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Activity text filter" Width="200"/>
                <Button Content="Apply filter" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanEdit}"/>
                <Button Content="Clear activity" Command="{Binding ClearCommand}" IsEnabled="{Binding CanEdit}"/>
            </WrapPanel>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,8" Visibility="{Binding Busy, Converter={StaticResource VisibleWhenTrue}}"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Recent operations" FontSize="20" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding Entries}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8"><Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:g}'}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Agent}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Action}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="3" Text="{Binding Outcome}"/>
                </Grid></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></Border>
    </StackPanel>
</UserControl>
