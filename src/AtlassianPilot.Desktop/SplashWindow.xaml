<Window x:Class="AtlassianPilot.Desktop.SplashWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" Height="280" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Background="#101B35" Icon="{StaticResource PilotLogo}">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Image Source="{StaticResource PilotLogo}" Width="76" Height="76" Margin="0,0,0,18"/>
        <TextBlock Text="AtlassianPilot" Foreground="White" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="Your Work. Your Agents. Your Control." Foreground="#A8B6CF" Margin="0,10,0,18"/>
        <TextBlock Text="Opening your local workspace..." Foreground="#22D3EE" FontSize="12" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>
