    <ProjectReference Include="..\AtlassianPilot.Agents\AtlassianPilot.Agents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
