<Window x:Class="AtlassianPilot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AtlassianPilot.Desktop.Views"
        Title="AtlassianPilot" Height="850" Width="1320" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource BackgroundBrush}" Icon="{StaticResource PilotLogo}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,26,14,20">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,28">
                    <StackPanel Orientation="Horizontal"><Image Source="{StaticResource PilotLogo}" Width="42" Height="42"/><TextBlock Text="AtlassianPilot" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
                    <TextBlock Text="YOUR PERSONAL COMMAND CENTRE" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="3,14,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,6,16"><StackPanel><TextBlock Text="LOCAL &amp; UNDER YOUR CONTROL" FontSize="10" Foreground="{DynamicResource CyanBrush}"/><TextBlock Text="Credentials protected by your Windows account." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
                    <Button Content="Switch light / dark" Command="{Binding ToggleThemeCommand}"/>
                    <Button Content="Help &amp; About" Command="{Binding NavigateCommand}" CommandParameter="Help &amp; About"/>
                    <TextBlock Text="Integrations • Phase 2" Style="{StaticResource Muted}" FontSize="11" Margin="3,6,0,0"/>
                    <TextBlock Text="{Binding DeveloperAttribution}" Style="{StaticResource Muted}" FontSize="11" Margin="3,6,0,0"/>
                    <TextBlock Text="Personal use only" Style="{StaticResource Muted}" FontSize="10" Margin="3,4,0,0"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Content="{Binding}" HorizontalContentAlignment="Left" Padding="14,14" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock Text="{Binding CopilotHeader}" Foreground="{DynamicResource CyanBrush}"/><TextBlock Text="{Binding CopilotModel}" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><Image Source="{StaticResource PilotLogo}" Width="30" Height="30" Margin="0,0,12,0"/><StackPanel><TextBlock Text="{Binding SelectedSection}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Your Work. Your Agents. Your Control." Style="{StaticResource Muted}" FontSize="12"/></StackPanel></StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="30,28,14,24">
                    <StackPanel Visibility="{Binding IsDashboard, Converter={StaticResource VisibleWhenTrue}}">
                        <Border Style="{StaticResource Card}" Background="{DynamicResource SidebarBrush}" Padding="32">
                            <StackPanel><TextBlock Text="LESS BUSYWORK. MORE MOMENTUM." Foreground="{DynamicResource CyanBrush}" FontSize="11"/><TextBlock Text="Your work, expertly navigated." FontSize="32" FontWeight="SemiBold" Margin="0,12,0,12"/><TextBlock Text="A dedicated desktop home for your Jira and Confluence agents. Start by securely configuring your workspace." Style="{StaticResource Muted}" MaxWidth="640" HorizontalAlignment="Left"/><Button Content="Configure integrations" Style="{StaticResource Primary}" Command="{Binding NavigateCommand}" CommandParameter="Integrations &amp; Settings" HorizontalAlignment="Left" Margin="0,22,0,0"/></StackPanel>
                        </Border>
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="JIRA" Foreground="{DynamicResource CyanBrush}" FontSize="11"/><TextBlock Text="{Binding JiraState}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="Issues, epics and workflows" Style="{StaticResource Muted}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CONFLUENCE" Foreground="{DynamicResource CyanBrush}" FontSize="11"/><TextBlock Text="{Binding ConfluenceState}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="Knowledge, pages and clarity" Style="{StaticResource Muted}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="GITHUB COPILOT" Foreground="{DynamicResource CyanBrush}" FontSize="11"/><TextBlock Text="{Binding CopilotState}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="Authentication and available models" Style="{StaticResource Muted}"/></StackPanel></Border>
                        </UniformGrid>
                        <TextBlock Text="Explore your workspace" FontSize="21" FontWeight="SemiBold" Margin="0,10,0,18"/>
                        <WrapPanel><Button Content="Jira Agent" Command="{Binding NavigateCommand}" CommandParameter="Jira Agent"/><Button Content="Create Jira" Command="{Binding NavigateCommand}" CommandParameter="Create Jira"/><Button Content="Jira Actions" Command="{Binding NavigateCommand}" CommandParameter="Jira Actions"/><Button Content="Confluence Agent" Command="{Binding NavigateCommand}" CommandParameter="Confluence Agent"/><Button Content="AI configuration" Command="{Binding NavigateCommand}" CommandParameter="AI Configuration"/></WrapPanel>
                        <Border Style="{StaticResource Card}" Margin="0,12,16,0"><StackPanel><TextBlock Text="Start with your agents" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Use Jira Agent for read-only searches and issue details, Create Jira for polished issue creation, and Jira Actions for approved updates, comments, assignment, transitions, links and limited clones. Confluence Agent searches and analyzes pages and prepares page saves for your explicit approval. Review Agent History and Activity Logs for locally retained records." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsSettings, Converter={StaticResource VisibleWhenTrue}}" MaxWidth="760" HorizontalAlignment="Stretch">
                        <TextBlock Text="Connect on your terms." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Configuration stays on this PC. Tokens are encrypted with Windows DPAPI." Style="{StaticResource Muted}" Margin="0,10,0,22"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Integration"/>
                                <DockPanel Margin="0,8,0,20" IsEnabled="{Binding CanEdit}"><Button DockPanel.Dock="Right" Content="Reload saved settings" Command="{Binding SelectIntegrationCommand}" Margin="12,0,0,0"/><ComboBox ItemsSource="{Binding IntegrationKinds}" SelectedItem="{Binding RequestedIntegration, Mode=OneWay}" SelectionChanged="IntegrationChanged" AutomationProperties.Name="Integration selector"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#16213B"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></DockPanel>
                                <TextBlock Text="{Binding SelectedIntegration}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/>
                                <StackPanel Visibility="{Binding IsAtlassian, Converter={StaticResource VisibleWhenTrue}}" IsEnabled="{Binding CanEdit}">
                                    <TextBlock Text="Base URL (HTTPS)"/><TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Base URL"/>
                                    <TextBlock Text="Atlassian email"/><TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Atlassian email"/>
                                    <TextBlock Text="{Binding ScopeLabel}"/><TextBox Text="{Binding DefaultScope, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Default project or space"/>
                                    <TextBlock Text="API token (write-only)"/><PasswordBox x:Name="TokenInput" PasswordChanged="TokenChanged" AutomationProperties.Name="API token"/>
                                    <TextBlock Text="{Binding CredentialStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,16"/>
                                    <WrapPanel><Button Content="Save securely" Style="{StaticResource Primary}" Click="SaveSettings"/><Button Content="Delete stored token" Click="DeleteToken" IsEnabled="{Binding HasCredential}"/></WrapPanel>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsCopilot, Converter={StaticResource VisibleWhenTrue}}" IsEnabled="{Binding CanEdit}">
                                    <TextBlock Text="Preferred model (optional)"/><TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Preferred Copilot model"/>
                                    <TextBlock Text="Available models"/>
                                    <ComboBox ItemsSource="{Binding AvailableModels}" SelectionChanged="ChooseModel" IsEnabled="{Binding HasAvailableModels}" AutomationProperties.Name="Available Copilot models" Margin="0,8,0,4"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Foreground="#16213B"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                    <TextBlock Text="{Binding AvailableModelsStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,18"/>
                                    <TextBlock Text="Leave the preference blank to use the runtime default. Selecting a discovered model fills the preference; save it before testing. GitHub credentials are managed by the official Copilot runtime, not pasted here." Style="{StaticResource Muted}" Margin="0,0,0,18"/>
                                    <WrapPanel><Button Content="Save model preference" Style="{StaticResource Primary}" Command="{Binding SaveCommand}"/><Button Content="Sign in with GitHub" Command="{Binding SignInCommand}"/><Button Content="Sign out" Click="SignOut"/></WrapPanel>
                                </StackPanel>
                                <WrapPanel Margin="0,14,0,0"><Button Content="Test connection" Command="{Binding TestConnectionCommand}" IsEnabled="{Binding CanEdit}"/><Button Content="Cancel operation" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}"/></WrapPanel>
                                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,16" Visibility="{Binding Busy, Converter={StaticResource VisibleWhenTrue}}"/>
                                <TextBlock Text="{Binding ConnectionDetails}" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
                                <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding HasDeviceCode, Converter={StaticResource VisibleWhenTrue}}">
                                    <StackPanel><TextBlock Text="Authorize GitHub Copilot" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Enter this one-time code on GitHub. Do not share the code." Style="{StaticResource Muted}" Margin="0,10,0,8"/><TextBlock Text="{Binding DeviceCode}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource CyanBrush}"/><TextBlock Text="{Binding VerificationUrl}" Style="{StaticResource Muted}" Margin="0,8,0,12"/><Button Content="Open GitHub verification page" Click="OpenVerificationPage" HorizontalAlignment="Left"/></StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Test results are for this session and do not guarantee every project/space permission. Tests use saved settings only. Copilot instructions and content are processed online; local storage does not mean offline AI." Style="{StaticResource Muted}"/>
                    </StackPanel>
                    <views:JiraCreateView DataContext="{Binding JiraCreate}" Visibility="{Binding DataContext.IsJiraCreate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}"/>
                    <views:JiraActionsView DataContext="{Binding JiraActions}" Visibility="{Binding DataContext.IsJiraActions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}"/>
                    <StackPanel Visibility="{Binding DataContext.IsJiraAgent, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" DataContext="{Binding JiraAgent}">
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="Jira Agent" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock Text="Ask for Jira searches or issue details here. To refine rough notes and create an issue after approval, open Create Jira in the sidebar. Requests and search results are sent to GitHub Copilot online; full issue fields remain local. Chat messages are saved unencrypted in the local database for 30 days and can be removed in Agent History. The Copilot runtime may retain additional local session data." Style="{StaticResource Muted}" Margin="0,10,0,16"/>
                            <ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12"><StackPanel><TextBlock Text="{Binding Speaker}" Foreground="{DynamicResource CyanBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBlock Text="Saved searches and examples" Margin="0,8,0,0"/>
                            <TextBlock Text="Choose an example or a saved search, then select Use selected. Replace any [placeholders] and review the request before searching. Specify a project when needed; the default project does not limit searches." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,8"/>
                            <ComboBox ItemsSource="{Binding Searches}" SelectedItem="{Binding SelectedSearch}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Saved Jira searches"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#16213B"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            <WrapPanel Margin="0,10,0,0"><Button Content="Use selected" Command="{Binding UseSearchCommand}" IsEnabled="{Binding HasSelectedSearch}"/><Button Content="Delete saved search" Click="DeleteSavedSearch" IsEnabled="{Binding HasSelectedSavedSearch}"/></WrapPanel>
                            <TextBlock Text="Your request" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Jira request"/>
                            <TextBlock Text="Name for a saved search"/><TextBox Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Saved search name"/>
                            <WrapPanel><Button Content="Save as new search" Command="{Binding SaveNewSearchCommand}" IsEnabled="{Binding CanEdit}"/><Button Content="Update selected search" Command="{Binding UpdateSearchCommand}" IsEnabled="{Binding HasSelectedSavedSearch}"/></WrapPanel>
                            <WrapPanel><Button Content="Search with Copilot" Style="{StaticResource Primary}" Command="{Binding SendCommand}" IsEnabled="{Binding CanEdit}"/><Button Content="New conversation" Command="{Binding NewConversationCommand}" IsEnabled="{Binding CanEdit}"/><Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}"/></WrapPanel>
                            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,10" Visibility="{Binding Busy, Converter={StaticResource VisibleWhenTrue}}"/>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="Jira results" FontSize="20" FontWeight="SemiBold"/>
                            <StackPanel Visibility="{Binding HasDraft, Converter={StaticResource VisibleWhenTrue}}">
                                <TextBlock Text="Issue draft (preview only)" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,8"/>
                                <TextBlock Text="This is a read-only draft. No issue was created. Use Create Jira in the sidebar for the refinement and approval workflow." Style="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding Draft.ProjectKey, StringFormat='Project: {0}'}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Draft.IssueType, StringFormat='Issue type: {0}'}"/>
                                <TextBlock Text="{Binding Draft.ParentKey, StringFormat='Parent: {0}', TargetNullValue='Parent: None supplied'}"/>
                                <TextBlock Text="{Binding Draft.Summary, StringFormat='Summary: {0}'}" TextWrapping="Wrap"/>
                                <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="{Binding Draft.Description}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Query}" Style="{StaticResource Muted}" Margin="0,8,0,12"/>
                            <StackPanel Visibility="{Binding HasIssueDetails, Converter={StaticResource VisibleWhenTrue}}">
                                <Button Content="{Binding IssueDetails.Key}" Tag="{Binding IssueDetails.Url}" Click="OpenIssue" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding IssueDetails.Summary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,6"/>
                                <WrapPanel><TextBlock Text="{Binding IssueDetails.Status, StringFormat='Status: {0}'}" Margin="0,0,18,0"/><TextBlock Text="{Binding IssueDetails.Assignee, StringFormat='Assignee: {0}'}" Margin="0,0,18,0"/><TextBlock Text="{Binding IssueDetails.Priority, StringFormat='Priority: {0}'}" Margin="0,0,18,0"/><TextBlock Text="{Binding IssueDetails.IssueType, StringFormat='Type: {0}'}"/></WrapPanel>
                                <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="{Binding IssueDetails.Description}" TextWrapping="Wrap"/>
                                <TextBlock Text="Raw fields returned by Jira (JSON). Nested comments and other collections may be paginated; issue history is not included. Full fields stay local; the request and issue key are sent to Copilot." Style="{StaticResource Muted}" Margin="0,12,0,8"/>
                                <TextBox Text="{Binding IssueDetails.FieldsJson, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="450" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Jira issue details"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Issues}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12"><StackPanel><Button Content="{Binding Key}" Tag="{Binding Url}" Click="OpenIssue" HorizontalAlignment="Left"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,6"/><WrapPanel><TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" Margin="0,0,18,0"/><TextBlock Text="{Binding Assignee, StringFormat='Assignee: {0}'}" Margin="0,0,18,0"/><TextBlock Text="{Binding Priority, StringFormat='Priority: {0}'}" Margin="0,0,18,0"/><TextBlock Text="{Binding IssueType, StringFormat='Type: {0}'}"/></WrapPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <Button Content="Load more" Command="{Binding LoadMoreCommand}" IsEnabled="{Binding CanLoadMore}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        </StackPanel></Border>
                    </StackPanel>
                    <views:ConfluenceAgentView DataContext="{Binding ConfluenceAgent}" Visibility="{Binding DataContext.IsAgent, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}"/>
                    <views:AgentHistoryView DataContext="{Binding History}" Visibility="{Binding DataContext.IsHistory, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}"/>
                    <views:ActivityLogView DataContext="{Binding Activity}" Visibility="{Binding DataContext.IsLogs, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}"/>
                                    <StackPanel Visibility="{Binding IsHelp, Converter={StaticResource VisibleWhenTrue}}">
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <Image Source="{StaticResource PilotLogo}" Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,18"/>
                                                <TextBlock Text="AtlassianPilot" FontSize="30" FontWeight="SemiBold"/>
                                                <TextBlock Text="Your Work. Your Agents. Your Control." Style="{StaticResource Muted}" Margin="0,10,0,18"/>
                                                <TextBlock Text="{Binding DeveloperAttribution}" FontSize="20" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding CopyrightNotice}" Margin="0,12,0,10"/>
                                                <TextBlock Text="{Binding UsageNotice}" Style="{StaticResource Muted}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="Getting started" FontSize="22" FontWeight="SemiBold"/>
                                                <TextBlock Text="1. Open Integrations &amp; Settings and select Jira. Enter the HTTPS Jira site URL, Atlassian email, optional project key and API token value only. Save securely, then click Test connection." Style="{StaticResource Muted}" Margin="0,16,0,12"/>
                                                <TextBlock Text="2. Select Confluence; the form switches automatically, with a warning for unsaved edits. Enter its HTTPS base URL (normally your site URL plus /wiki), email, optional space key and token. Save and test." Style="{StaticResource Muted}" Margin="0,0,0,12"/>
                                                <TextBlock Text="3. In AI Configuration, click Sign in with GitHub, open the verification page and enter the one-time code. The runtime stores GitHub credentials securely; plaintext persistence is refused. Choose an available model or leave the preference blank." Style="{StaticResource Muted}" Margin="0,0,0,12"/>
                                                <TextBlock Text="4. Use Jira Agent for read-only searches/details; Create Jira to refine and approve issue creation; or Jira Actions for approved issue updates, comments, assignment, transitions, links and limited clones. Review exact previews and check Jira before retrying an uncertain outcome." Style="{StaticResource Muted}" Margin="0,0,0,12"/>
                                                <TextBlock Text="The README.md in the project folder contains the full beginner setup guide, example URLs, token management instructions and troubleshooting. Never paste tokens into chats or screenshots." Style="{StaticResource Muted}"/>
                                                <Button Content="Configure integrations" Style="{StaticResource Primary}" Command="{Binding NavigateCommand}" CommandParameter="Integrations &amp; Settings" HorizontalAlignment="Left" Margin="0,20,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                            <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}" Padding="24,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><TextBlock Text="{Binding Notification}" Foreground="{DynamicResource CyanBrush}" FontSize="12" AutomationProperties.LiveSetting="Polite"/></Border>
                        </Grid>
                    </Grid>
                </Window>
